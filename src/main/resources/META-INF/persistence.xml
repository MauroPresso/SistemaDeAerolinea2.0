<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd" version="3.0">
  <persistence-unit name="Aerolinea-H2">
    <class>aerolinea.dominio.Aerolinea</class>
    <class>aerolinea.dominio.Persona</class>
    <class>aerolinea.dominio.Pasajero</class>
    <class>aerolinea.dominio.Tripulante</class>
    <class>aerolinea.dominio.Pasaporte</class>
    <class>aerolinea.dominio.Vuelo</class>
    <class>aerolinea.dominio.VueloNacional</class>
    <class>aerolinea.dominio.VueloInternacional</class>
    <class>aerolinea.dominio.VueloCharter</class>
    <exclude-unlisted-classes/>
    <properties>
      <property name="javax.jdo.PersistenceManagerFactoryClass" value="org.datanucleus.api.jdo.JDOPersistenceManagerFactory"/>
      <property name="javax.jdo.option.ConnectionDriverName" value="org.h2.Driver"/>
      <property name="javax.jdo.option.ConnectionURL" value="jdbc:h2:./data/aerolinea2"/>
      <property name="javax.jdo.option.ConnectionUserName" value="sa"/>
      <property name="javax.jdo.option.ConnectionPassword" value=""/>
      <property name="datanucleus.schema.autoCreateAll" value="true"/>
      <property name="datanucleus.schema.validateAll" value="true"/>
      <property name="datanucleus.manageRelationships" value="true"/>
      <property name="datanucleus.deletionPolicy" value="DataNucleus"/>
      <property name="javax.jdo.option.NontransactionalRead" value="true"/>
      <property name="javax.jdo.option.RetainValues" value="true"/>
      <property name="javax.jdo.option.Optimistic" value="true"/>
      <property name="datanucleus.cache.level2.type" value="none"/>
    </properties>
  </persistence-unit>
  <persistence-unit name="Aerolinea-MySQL">
    <class>aerolinea.dominio.Aerolinea</class>
    <class>aerolinea.dominio.Persona</class>
    <class>aerolinea.dominio.Pasajero</class>
    <class>aerolinea.dominio.Tripulante</class>
    <class>aerolinea.dominio.Pasaporte</class>
    <class>aerolinea.dominio.Vuelo</class>
    <class>aerolinea.dominio.VueloNacional</class>
    <class>aerolinea.dominio.VueloInternacional</class>
    <class>aerolinea.dominio.VueloCharter</class>
    <exclude-unlisted-classes/>
    <properties>
      <property name="javax.jdo.PersistenceManagerFactoryClass" value="org.datanucleus.api.jdo.JDOPersistenceManagerFactory"/>
      <property name="javax.jdo.option.ConnectionDriverName" value="com.mysql.cj.jdbc.Driver"/>
      <property name="javax.jdo.option.ConnectionURL" value="jdbc:mysql://localhost:3306/aerolinea2"/>
      <property name="javax.jdo.option.ConnectionUserName" value="programacion2"/>
      <property name="javax.jdo.option.ConnectionPassword" value=""/>
      <property name="datanucleus.schema.autoCreateAll" value="true"/>
      <property name="datanucleus.schema.validateAll" value="true"/>
      <property name="datanucleus.manageRelationships" value="true"/>
      <property name="datanucleus.deletionPolicy" value="DataNucleus"/>
      <property name="javax.jdo.option.NontransactionalRead" value="true"/>
      <property name="javax.jdo.option.RetainValues" value="true"/>
      <property name="javax.jdo.option.Optimistic" value="true"/>
      <property name="datanucleus.cache.level2.type" value="none"/>
    </properties>
  </persistence-unit>
</persistence>
